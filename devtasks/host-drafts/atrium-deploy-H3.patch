+
+# H3 (pre-brief models-hardening, L5a): load the client page in headless
+# Chromium and require it to start. It runs as a transient unit that never runs
+# as root. Two attempts; a second failure returns 1, so in the deploy path the
+# ERR trap rolls back exactly as for a failed public health check, and in the
+# same-SHA path the script exits non-zero.
+# The shape matters (second review, S8): `run` gets systemd-run (an external
+# command) directly, inside an `if`, so a first failure neither rolls back nor
+# runs the ERR trap inside the child. RuntimeMaxSec bounds a unit that a
+# rollback leaves behind.
+check_client_smoke() {
+  local attempt
+  for attempt in 1 2; do
+    if run systemd-run --quiet --pipe --wait --collect \
+        --unit="atrium-smoke-$$-$attempt" \
+        --uid=atrium-smoke --gid=atrium-smoke \
+        -p RuntimeMaxSec=120 -p MemoryMax=1G -p NoNewPrivileges=yes -p PrivateTmp=yes \
+        -p ProtectSystem=strict -p ProtectHome=yes \
+        -E PLAYWRIGHT_BROWSERS_PATH="$SMOKE_DIR/browsers" -E HOME=/tmp \
+        "$SMOKE_DIR/venv/bin/python" "$SMOKE_DIR/atrium-client-smoke" \
+        "$PUBLIC_CLIENT_PAGE" --require-id ep-model --timeout 40; then
+      return 0
+    fi
+    echo "SMOKE attempt $attempt of 2 failed"
+  done
+  return 1
+}

