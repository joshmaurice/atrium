{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Add (Server)",
  "description": "Server add broadcast. A request-caused add carries requestSeq and session; an avatar add carries id and neither.",
  "type": "object",
  "required": ["type", "seq", "node"],
  "properties": {
    "type": { "const": "add" },
    "seq": { "type": "integer", "minimum": 0 },
    "id": { "type": "string", "description": "Session UUID — present on an avatar add broadcast" },
    "format": { "const": "gltf", "description": "add-check A2/A8 — the only format the server stores and forwards" },
    "parent": { "type": ["string", "null"] },
    "requestSeq": { "type": "integer", "minimum": 0, "description": "The seq of the client request this broadcast answers" },
    "session": { "type": "string", "minLength": 1, "description": "The requesting session's id" },
    "node": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "translation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "extras": { "type": "object" },
        "extensions": { "type": "object" },
        "mesh": {
          "type": "object",
          "description": "glTF mesh descriptor with primitives including geometry and material (add-check A3/A4)",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 256 },
            "primitives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attributes"],
                "properties": {
                  "attributes": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["POSITION"],
                    "properties": {
                      "POSITION": {
                        "type": "array",
                        "items": { "type": "number" },
                        "minItems": 9
                      },
                      "NORMAL": {
                        "type": "array",
                        "items": { "type": "number" }
                      }
                    }
                  },
                  "indices": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 }
                  },
                  "material": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pbrMetallicRoughness": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "baseColorFactor": {
                            "type": "array",
                            "items": { "type": "number" },
                            "minItems": 4,
                            "maxItems": 4
                          },
                          "metallicFactor": { "type": "number" },
                          "roughnessFactor": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
