{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Add (Client)",
  "description": "Add a node to the scene graph",
  "type": "object",
  "required": ["type", "seq", "node"],
  "properties": {
    "type": { "const": "add" },
    "seq": { "type": "integer", "minimum": 0 },
    "id": { "type": "string", "description": "Session UUID — identifies the sender when adding an avatar node" },
    "format": { "const": "gltf", "description": "add-check A2/A8 — the only format the server stores and forwards" },
    "parent": { "type": ["string", "null"] },
    "node": { "$ref": "#/definitions/node" }
  },
  "additionalProperties": false,
  "definitions": {
    "node": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "translation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "extras": { "type": "object" },
        "extensions": { "type": "object" },
        "mesh": {
          "type": "object",
          "description": "glTF mesh descriptor with primitives including geometry and material (add-check A3/A4; richer-add R1/R5: the value rules are checkAddNode's)",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 256 },
            "extras": { "type": "object" },
            "primitives": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attributes"],
                "properties": {
                  "extras": { "type": "object" },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["POSITION"],
                    "properties": {
                      "POSITION": {
                        "type": "array",
                        "items": { "type": "number" },
                        "minItems": 9
                      },
                      "NORMAL": { "type": "array", "items": { "type": "number" } },
                      "TEXCOORD_0": { "type": "array", "items": { "type": "number" } },
                      "TEXCOORD_1": { "type": "array", "items": { "type": "number" } },
                      "COLOR_0": { "type": "array", "items": { "type": "number" } }
                    }
                  },
                  "indices": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 }
                  },
                  "material": {
                    "description": "subtree-add T12: a material, or { ref: n } naming the n-th material given earlier in the same message (message order: members depth-first pre-order, primitives in order); the order is checkAddNode's",
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "name": { "type": "string", "maxLength": 256 },
                          "extras": { "type": "object" },
                          "emissiveFactor": {
                            "type": "array",
                            "items": { "type": "number" },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "alphaMode": { "enum": ["OPAQUE", "MASK", "BLEND"] },
                          "alphaCutoff": { "type": "number", "minimum": 0 },
                          "doubleSided": { "type": "boolean" },
                          "pbrMetallicRoughness": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "baseColorFactor": {
                                "type": "array",
                                "items": { "type": "number" },
                                "minItems": 4,
                                "maxItems": 4
                              },
                              "metallicFactor": { "type": "number" },
                              "roughnessFactor": { "type": "number" }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["ref"],
                        "properties": { "ref": { "type": "integer", "minimum": 0 } }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/node" },
          "description": "subtree-add T1/T8: the node's children, each a node of this same form. The bounds (256 members, 8 generations, 1,024 primitives), the names and ids rules and the material-ref order are checkAddNode's"
        }
      },
      "additionalProperties": false
    }
  }
}
